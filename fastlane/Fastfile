    cloned_source_packages_path: source_packages_path,
    clean: is_localhost,
    build_for_testing: true,
    xcodebuild_formatter: xcodebuild_formatter
  )
end

lane :start_mock_server do |options|
  mock_server_repo = 'stream-chat-test-mock-server'
  stop_mock_server if is_localhost

  if options[:local_server]
    mock_server_repo = options[:local_server]
  else
    branch = options[:branch].to_s.empty? ? 'main' : options[:branch]
    sh("rm -rf #{mock_server_repo}") if File.directory?(mock_server_repo)
    sh("git clone -b #{branch} https://github.com/#{github_repo.split('/').first}/#{mock_server_repo}.git")
  end

  pids = sh("lsof -ti :#{mock_server_driver_port} || true", log: false).strip
  sh("kill -9 #{pids} || true", log: false) unless pids.empty?

  Dir.chdir(mock_server_repo) do
    FileUtils.mkdir_p('logs')
    sh("bundle exec ruby driver.rb #{mock_server_driver_port} > logs/driver.log 2>&1 &")
  end
end

lane :stop_mock_server do
  begin
    Net::HTTP.get_response(URI("http://localhost:#{mock_server_driver_port}/stop"))
  rescue StandardError
    nil
  end
end

desc 'Runs e2e ui tests using mock server in Debug config'
lane :test_e2e_mock do |options|
  next unless is_check_required(sources: @impact[:e2e][:sources], force_check: @force_check, required_checks: @impact[:e2e][:checks])

  start_mock_server
  allow_photo_library_access(device: options[:device])

  scan_options = {
    project: xcode_project,
    scheme: 'StreamChatSwiftUITestsApp',
    testplan: 'StreamChatSwiftUITestsApp',
    result_bundle: true,
    derived_data_path: derived_data_path,
    cloned_source_packages_path: source_packages_path,
    clean: is_localhost && !options[:test_without_building],
    test_without_building: options[:test_without_building],
    devices: options[:device],
    prelaunch_simulator: is_ci,
    xcodebuild_formatter: xcodebuild_formatter
  }

  if options[:coverage]
    scan(scan_options.merge(build_for_testing: true, code_coverage: true))
    scan_options[:test_without_building] = true
    scan_options[:clean] = false
    FileUtils.rm_rf(e2e_coverage_dir)
    ENV['TEST_RUNNER_E2E_COVERAGE_DIR'] = e2e_coverage_dir
  end

  if ENV['MATRIX_SIZE'] && options[:batch]
    tests = File.exist?(e2e_selection_path) ? JSON.parse(File.read(e2e_selection_path))['tests'] : all_e2e_tests
    slice_size = [(tests.size / ENV['MATRIX_SIZE'].to_f).ceil, 1].max
    only_testing_batch = tests.each_slice(slice_size).to_a[options[:batch].to_i].to_a
    UI.important("Tests in total: #{tests.size}. Running #{only_testing_batch.size} of them ⌛️")
    next if only_testing_batch.empty?

    scan_options[:only_testing] = only_testing_batch
  end

  failed_tests = []
  begin
    scan_with_retries(scan_options: scan_options)
  rescue StandardError
    # Each retry overwrites the junit report, so only the tests that failed on the last attempt stay failed for the coverage map.
    failed_tests = retreive_failed_tests
    raise
  ensure
    build_e2e_coverage_map(failed_tests: failed_tests) if options[:coverage]
  end
end

desc 'Picks the e2e tests the pull request can affect and exposes how many CI batches they need'
lane :select_e2e_tests do |options|
  all_tests = all_e2e_tests
  UI.user_error!('No e2e tests found in the built xctestrun') if all_tests.empty?
  tests = []
  # A manual run's tip may be a "Merge develop" commit, which the selection would mistake for a pull request merge.
  run_all_reason =
    if is_ci && ENV['GITHUB_EVENT_NAME'] != 'pull_request'
      'not a pull request'
    elsif ENV['GITHUB_HEAD_REF'].to_s.start_with?('release/') || ENV['GITHUB_BASE_REF'] == 'main'
      'release pull request'
    end
  if run_all_reason
    UI.important("Running all #{all_tests.size} tests: #{run_all_reason}")
    tests = all_tests
    File.write(e2e_selection_path, JSON.generate(run_all: true, tests: tests, reasons: [run_all_reason]))
  elsif is_check_required(sources: @impact[:e2e][:sources], force_check: @force_check, required_checks: @impact[:e2e][:checks])
    selection = select_impacted_tests(
      all_tests: all_tests,
      coverage_map: options[:coverage_map],
      coverage_map_artifact: e2e_coverage_map_artifact,
      diff_base: options[:diff_base],
      changed_files: options[:changed_files]&.split(','),
      source_paths: ['Sources', 'StreamChatSwiftUITestsApp'],
      test_paths: ['StreamChatSwiftUITestsAppTests/Tests'],
      ignore_paths: ['**/*.md', '**/*.stencil', '**/*.yml', 'Sources/*/Info.plist'],
      run_all_paths: [
        'StreamChatSwiftUITestsAppTests/Tests/BaseTestCase',
        'StreamChatSwiftUITestsAppTests/Extensions',
        'StreamChatSwiftUITestsAppTests/Pages',
        'StreamChatSwiftUITestsAppTests/Robots',
        'StreamChatSwiftUITestsAppTests/StreamChatSwiftUITestsApp.xctestplan',
        'StreamChatSwiftUITestsAppTests/StreamChatSwiftUITests.swift',
        'Package.swift'
      ],
      # Changes to code nearly every test runs (launch, login, channel list) take one test per class; the nightly run covers the rest.
      hot_test_ratio: 0.9,
      output_path: e2e_selection_path
    )
    tests = selection['tests']
  else
    File.write(e2e_selection_path, JSON.generate(run_all: false, tests: [], reasons: ['no e2e sources changed']))
  end

  # Up to 3 batches, none bigger than a third of the suite, so a small selection takes fewer runners.
  max_batches = 3
  batch_size = (all_tests.size / max_batches.to_f).ceil
  batches = (0...[(tests.size / batch_size.to_f).ceil, max_batches].min).to_a
  UI.important("E2E batches: #{batches.size}")
  File.write(ENV['GITHUB_OUTPUT'], "e2e_batches=#{batches.to_json}\n", mode: 'a') if ENV['GITHUB_OUTPUT']
  batches
end

private_lane :build_e2e_coverage_map do |options|
  next UI.important('No e2e coverage was collected') if Dir.glob("#{e2e_coverage_dir}/*/*/*.profraw").empty?

  app = Dir.glob(File.expand_path("../#{derived_data_path}/Build/Products/*-iphonesimulator/StreamChatSwiftUITestsApp.app")).first
  executable = ["#{app}/StreamChatSwiftUITestsApp.debug.dylib", "#{app}/StreamChatSwiftUITestsApp"].find { |path| File.exist?(path) }
  frameworks = Dir.glob("#{app}/Frameworks/*.framework").map { |framework| "#{framework}/#{File.basename(framework, '.framework')}" }

  build_test_coverage_map(
    coverage_dir: e2e_coverage_dir,
    binaries: [executable] + frameworks,
    output_path: e2e_coverage_map_path,
    previous_map_artifact: e2e_coverage_map_artifact,
    failed_tests: options[:failed_tests]
  )
end

# The test runner saves a video to the photo library and the app's media picker reads it. Granting access up front
# avoids the system prompts, which can be dismissed as "Don't Allow" when they're not answered in time and then
# stay denied for every retry.
private_lane :allow_photo_library_access do |options|
  next UI.important('No device is given, photo library access is not granted') unless options[:device]

  name, os_version = options[:device].match(/^(.+?)(?: \(([\d.]+)\))?$/).captures
  simulators = FastlaneCore::DeviceManager.simulators('iOS')
  simulator =
    if os_version
      simulators.find { |device| device.name == name && Gem::Version.new(device.os_version) == Gem::Version.new(os_version) }
    else
      # Same pick as `scan` makes for a device without a version, so both target the same simulator.
      Scan::DetectValues.highest_compatible_simulator(simulators, name)
    end
  UI.user_error!("No simulator matches #{options[:device]}, photo library access cannot be granted") unless simulator

  sh("xcrun simctl bootstatus #{simulator.udid} -b")
  sh("xcrun simctl privacy #{simulator.udid} grant photos-add io.getstream.iOS.StreamChatSwiftUITestsAppTests.xctrunner")
  sh("xcrun simctl privacy #{simulator.udid} grant photos io.getstream.iOS.StreamChatSwiftUITestsApp")
end

private_lane :all_e2e_tests do
  xctestrun = Dir.glob(File.expand_path("../#{derived_data_path}/Build/Products/*.xctestrun")).first
  retrieve_xctest_names(xctestrun: xctestrun).values.flatten
end

# Runs scan and re-runs only the tests that failed, up to `retries` times.
# Every attempt recalculates the failing set from the previous run's junit
# report, so a shrinking set of flaky tests converges instead of dragging
# the whole suite along.
private_lane :scan_with_retries do |options|
  scan_options = options[:scan_options]
  attempts_left = options[:retries] || 3

  begin
    # scan raises on a build or launch error before rewriting the report, so a stale one must not drive the retry.
    FileUtils.rm_f('test_output/report.junit')
    scan(scan_options)
  rescue StandardError
    raise if attempts_left.zero?

    failed_tests = retreive_failed_tests
    raise if failed_tests.empty?

    attempts_left -= 1
    UI.important("Re-running #{failed_tests.size} failed tests ⌛️ (#{attempts_left} retries left)")
    scan_options = scan_options.merge(only_testing: failed_tests, clean: false)
    retry
  end
end

private_lane :retreive_failed_tests do
  report_path = 'test_output/report.junit'
  next [] unless File.file?(report_path)

  junit_report = Nokogiri::XML(File.read(report_path))
  failed_tests = []
  passed_tests = []
  suite = junit_report.xpath('//testsuite').first
  suite_name = suite && suite['name']
  next [] if suite_name.nil? || suite_name.empty?

  suite_name = suite_name.split('.').first
  junit_report.xpath('//testcase').each do |testcase|
    class_name = testcase['classname'].split('.').last
    test_name = testcase['name'].delete('()')

    if testcase.at_xpath('failure')
      failed_tests << "#{suite_name}/#{class_name}/#{test_name}"
    else
      passed_tests << "#{suite_name}/#{class_name}/#{test_name}"
    end
  end

  (failed_tests - passed_tests).uniq
end

