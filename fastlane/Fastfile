desc "Updates StreamChat dependency locally. Usage: `bundle exec fastlane update_stream_chat version:5.9.0`"
lane :update_stream_chat do |options|
  version = options[:version]
  UI.user_error!('Provide a version.') unless version

  Dir.chdir('..') do
    # The dependency is pinned to a develop revision between releases, so accept any requirement kind
    file = 'Package.swift'
    content = File.read(file)
    dependency = /(stream-chat-swift\.git",\s*)(?:from|exact|branch|revision): "[^"]+"/
    UI.user_error!("Could not find the StreamChat dependency in #{file}") unless content.match?(dependency)
    File.write(file, content.sub(dependency, "\\1from: \"#{version}\""))

    file = 'StreamChatSwiftUI.xcodeproj/project.pbxproj'
    content = File.read(file)
    requirement = /(stream-chat-swift\.git";\s*requirement = \{)[^}]*\n(\s*)\};/
    UI.user_error!("Could not find the StreamChat package reference in #{file}") unless content.match?(requirement)
    File.write(file, content.sub(requirement) { "#{$1}\n#{$2}\tkind = upToNextMajorVersion;\n#{$2}\tminimumVersion = #{version};\n#{$2}};" })
  end

  pr_create(
    title: "Update StreamChat dependency to #{version}",
    base_branch: 'develop',
    head_branch: "ci/update-stream-chat-dependency-#{Time.now.to_i}",
    github_repo: github_repo
  )
end

